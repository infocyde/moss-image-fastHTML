# Copy to .env and edit. All optional.

# Engine on first launch: managed (local sd-server) | remote | mock. Later changes in the UI are saved to data/engine.json
# MOSS_ENGINE=managed

# Path to stable-diffusion.cpp's sd-server (default: ./sdcpp/sd-server.exe)
# SD_SERVER_BIN=C:\_activeDev\moss_image\sdcpp\sd-server.exe
# SD_SERVER_PORT=7861

# Remote engine (RunPod etc.) — an sd-server reachable over HTTP
# SD_SERVER_URL=http://123.45.67.89:7861

# Prompt / layout enhancer: any OpenAI-compatible endpoint (LM Studio default)
# ENHANCER_URL=http://127.0.0.1:1234/v1
# ENHANCER_MODEL=           # blank = first loaded chat model
# ENHANCER_API_KEY=lm-studio

# Web UI
# APP_HOST=127.0.0.1
# APP_PORT=5001

# Folders (relative to this folder or absolute)
# MODELS_DIR=models
# OUTPUTS_DIR=outputs
